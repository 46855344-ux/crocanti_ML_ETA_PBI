# ============================================================
# VARIABLES DE ENTORNO · CROCANTI BACKEND
# Copia este archivo como .env y completa los valores reales.
# ============================================================

# Cadena de conexión de Neon PostgreSQL
DATABASE_URL=postgresql://usuario:clave@ep-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require

# Puerto HTTP del backend
PORT=3000

# Clave para firmar los JWT (usa una cadena larga y aleatoria)
JWT_SECRET=cambia-esta-clave-por-una-aleatoria-de-64-caracteres

# Vigencia del token de sesión (ej. 30d, 12h)
JWT_EXPIRA=30d

# Códigos de invitación para crear cuentas de staff desde la app ADMIN
ADMIN_INVITE_CODE=CROCANTI-ADMIN
REPARTIDOR_INVITE_CODE=CROCANTI-REPARTIDOR

# ============================================================
# OBJECT STORAGE (NEON S3) · FOTOS DE ENTREGA
# ============================================================
# El bucket debe existir y, para que la URL guardada sea legible,
# debe haberse creado como public_read en Neon Console.
# Si no se configura, la API usa el respaldo local uploads/.
AWS_ENDPOINT_URL_S3=https://ep-xxxx.storage.c-7.us-east-2.aws.neon.tech
AWS_REGION=us-east-2
AWS_ACCESS_KEY_ID=tu_access_key_de_neon
AWS_SECRET_ACCESS_KEY=tu_secret_key_de_neon
S3_BUCKET=crocanti-entregas

# Opcional: si usas un CDN o dominio propio para el bucket.
# S3_PUBLIC_BASE_URL=https://cdn.tudominio.com/crocanti-entregas
